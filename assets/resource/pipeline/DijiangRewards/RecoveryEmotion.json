    "RecoveryEmotionSelectLowEmotion": {
        "desc": "[恢复心情·操作] 按已勾选舱室筛选当前列表，点击首个匹配干员",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    240,
                    540,
                    280
                ],
                "expected": [
                    // 运行时由 RecoveryEmotionInitSelectTarget 覆盖为已勾选舱室白名单
                    "^PLACEHOLDER$"
